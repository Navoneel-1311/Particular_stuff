---
import Layout from '../layouts/Layout.astro';

// Placeholder roster grouped by vertical — swap in real names/photos.
const verticals = [
  {
    name: 'Corporate Partnerships',
    people: ['Vertical Head', 'Coordinator', 'Coordinator'],
  },
  {
    name: 'Operations & Hospitality',
    people: ['Vertical Head', 'Coordinator', 'Coordinator'],
  },
  {
    name: 'Marketing & Publicity',
    people: ['Vertical Head', 'Coordinator', 'Coordinator'],
  },
  {
    name: 'Content & Design',
    people: ['Vertical Head', 'Coordinator'],
  },
  {
    name: 'Sponsorship',
    people: ['Vertical Head', 'Coordinator', 'Coordinator'],
  },
  {
    name: 'Logistics',
    people: ['Vertical Head', 'Coordinator'],
  },
];

const initials = (name: string) =>
  name.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<Layout title="Team | i5 Summit | IIM Indore" description="The student team behind i5 Summit, IIM Indore's flagship entrepreneurship festival.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Run by students</span>
      <h1>The team.</h1>
      <p class="page-sub">i5 Summit is organized entirely by IIM Indore students, across six verticals.</p>
    </div>
  </section>

  <section class="team-section">
    <div class="wrap">
      {verticals.map((v) => (
        <div class="vertical-block">
          <h2>{v.name}</h2>
          <div class="people-grid">
            {v.people.map((p) => (
              <div class="person-card">
                <div class="avatar">{initials(p)}</div>
                <div>
                  <h3>Name Surname</h3>
                  <p>{p}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
      <p class="note">Placeholder roster — real names and photos to be added.</p>
    </div>
  </section>

  <style>
    .page-hero { padding-top: 72px; padding-bottom: 40px; }
    .page-hero h1 {
      margin-top: 16px;
      font-size: clamp(36px, 5.5vw, 58px);
      font-weight: 900;
    }
    .page-sub {
      margin-top: 16px;
      font-size: 17px;
      color: var(--slate);
      max-width: 50ch;
    }

    .team-section { padding-top: 16px; }
    .vertical-block {
      padding: 36px 0;
      border-top: 1px solid var(--line);
    }
    .vertical-block:last-of-type { border-bottom: 1px solid var(--line); }
    .vertical-block h2 {
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--maroon);
      margin-bottom: 22px;
    }
    .people-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .person-card {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .avatar {
      width: 46px;
      height: 46px;
      border-radius: 999px;
      background: var(--paper-alt);
      border: 1px solid var(--line-strong);
      color: var(--slate);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 12.5px;
      flex-shrink: 0;
    }
    .person-card h3 { font-size: 14.5px; font-weight: 700; }
    .person-card p { margin-top: 3px; font-size: 12.5px; color: var(--slate); }
    .note {
      margin-top: 12px;
      font-size: 13px;
      color: var(--slate);
      font-style: italic;
    }

    @media (max-width: 900px) {
      .people-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</Layout>
