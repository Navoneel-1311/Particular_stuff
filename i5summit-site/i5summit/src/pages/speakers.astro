---
import Layout from '../layouts/Layout.astro';

// Placeholder roster — swap in confirmed names, titles, and headshots
// closer to the event. Keep the (role · org) format for consistency.
const speakers = Array.from({ length: 8 }).map((_, i) => ({
  name: 'Speaker Name',
  role: 'Founder & CEO',
  org: 'Company Name',
  initials: 'SN',
}));

const pastHighlights = [
  { name: 'CS Ujjawal Pahwa', role: 'Finance Content Creator', initials: 'UP' },
  { name: 'Anuva Kakkar', role: 'Founder, Tiggle Chocolate Drinks', initials: 'AK' },
  { name: 'Manan Dixit', role: 'Founder & CEO, FidyPay', initials: 'MD' },
];
---
<Layout title="Guests | i5 Summit | IIM Indore" description="Founders, investors, and industry leaders speaking at i5 Summit, IIM Indore.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Who's on stage</span>
      <h1>Guests & speakers.</h1>
      <p class="page-sub">Founders, operators, and investors sharing what actually happened, not just the highlight reel.</p>
    </div>
  </section>

  <section class="speakers-grid-section">
    <div class="wrap">
      <div class="section-head" style="margin-bottom: 32px;">
        <span class="eyebrow">2025 line-up</span>
        <h2 style="font-size: 26px; margin-top: 10px;">Confirming soon</h2>
      </div>
      <div class="speakers-grid">
        {speakers.map((s) => (
          <div class="speaker-card">
            <div class="avatar">{s.initials}</div>
            <h3>{s.name}</h3>
            <p>{s.role}</p>
            <p class="org">{s.org}</p>
          </div>
        ))}
      </div>
      <p class="note">Placeholder roster — names, roles, and photos will be updated as speakers are confirmed.</p>
    </div>
  </section>

  <section class="past-section">
    <div class="wrap">
      <div class="section-head" style="margin-bottom: 32px;">
        <span class="eyebrow">Past editions</span>
        <h2 style="font-size: 26px; margin-top: 10px;">Who's spoken at i5 before</h2>
      </div>
      <div class="past-grid">
        {pastHighlights.map((s) => (
          <div class="past-card">
            <div class="avatar avatar-sm">{s.initials}</div>
            <div>
              <h4>{s.name}</h4>
              <p>{s.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .page-hero { padding-top: 72px; padding-bottom: 40px; }
    .page-hero h1 {
      margin-top: 16px;
      font-size: clamp(36px, 5.5vw, 58px);
      font-weight: 900;
    }
    .page-sub {
      margin-top: 16px;
      font-size: 17px;
      color: var(--slate);
      max-width: 50ch;
    }

    .speakers-grid-section { padding-top: 16px; }
    .speakers-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
    }
    .speaker-card {
      background: var(--paper);
      padding: 28px 20px;
      text-align: left;
    }
    .avatar {
      width: 52px;
      height: 52px;
      border-radius: 3px;
      background: var(--maroon-soft);
      color: var(--maroon);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 18px;
    }
    .speaker-card h3 { font-size: 15.5px; font-weight: 700; }
    .speaker-card p { margin-top: 4px; font-size: 13.5px; color: var(--slate); }
    .speaker-card .org { color: var(--gold); }
    .note {
      margin-top: 20px;
      font-size: 13px;
      color: var(--slate);
      font-style: italic;
    }

    .past-section { background: var(--paper-alt); }
    .past-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .past-card {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--paper);
      border: 1px solid var(--line);
      padding: 18px;
      border-radius: 3px;
    }
    .avatar-sm { width: 44px; height: 44px; font-size: 12px; margin-bottom: 0; flex-shrink: 0; }
    .past-card h4 { font-size: 14.5px; font-weight: 700; }
    .past-card p { margin-top: 3px; font-size: 12.5px; color: var(--slate); }

    @media (max-width: 900px) {
      .speakers-grid { grid-template-columns: repeat(2, 1fr); }
      .past-grid { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
