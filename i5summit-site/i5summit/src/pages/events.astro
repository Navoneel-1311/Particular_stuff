---
import Layout from '../layouts/Layout.astro';

const events = [
  {
    n: 1,
    tag: 'Flagship · Day 3',
    title: 'Get Funded',
    copy: "The centerpiece of i5 Summit. Startups submit business plans that are shortlisted by an internal jury of IIM Indore faculty, then pitch live on campus to a panel of venture capitalists and angel investors. Past editions have driven funding conversations worth crores across dozens of shortlisted ventures.",
    meta: ['Live pitch', 'VC & angel panel', 'Faculty-shortlisted'],
  },
  {
    n: 2,
    tag: 'Networking · Day 1',
    title: 'Chai pe Charcha',
    copy: "An intentionally informal session — founders, investors, and students talk shop over chai, without a stage or a script. It's where most of the real connections at i5 Summit actually happen.",
    meta: ['Informal format', 'Founders & investors', 'Small-group'],
  },
  {
    n: 3,
    tag: 'Immersion · Day 2',
    title: 'A Day at IIM Indore',
    copy: "Built for MBA aspirants. Participants sit in on a live case discussion, get a feel for classroom life, and talk directly to current students about admissions, the two-year journey, and what it's actually like on campus.",
    meta: ['Case simulation', 'Current-student Q&A', 'Campus tour'],
  },
  {
    n: 4,
    tag: 'Sessions · All 3 days',
    title: 'Panels & Speaker Series',
    copy: "Keynotes and panel discussions with founders, CXOs, and industry leaders, unpacking the decisions that shaped their ventures — from first product to first big raise.",
    meta: ['Keynotes', 'Panel discussions', 'Open Q&A'],
  },
  {
    n: 5,
    tag: 'Workshops · Day 1–2',
    title: 'Startup & Management Workshops',
    copy: "Hands-on sessions on the mechanics of building a venture — positioning, digital marketing, pitching, and early-stage fundraising — run by practitioners, not just theorists.",
    meta: ['Hands-on', 'Small cohorts', 'Practitioner-led'],
  },
];
---
<Layout title="Events | i5 Summit | IIM Indore" description="Get Funded, Chai pe Charcha, A Day at IIM Indore, and the rest of i5 Summit's flagship event line-up.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Three days on campus</span>
      <h1>The line-up.</h1>
      <p class="page-sub">Five formats, one goal — take a room full of ideas and get a few of them funded.</p>
    </div>
  </section>

  <section class="events-list">
    <div class="wrap">
      {events.map((e) => (
        <div class="event-row">
          <div class="event-num">
            <span class="exp">i<sup>{e.n}</sup></span>
          </div>
          <div class="event-body">
            <span class="event-tag">{e.tag}</span>
            <h2>{e.title}</h2>
            <p>{e.copy}</p>
            <div class="event-meta">
              {e.meta.map((m) => <span>{m}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-strip">
    <div class="wrap cta-strip-inner">
      <h2>Want to pitch at Get Funded?</h2>
      <a href="#" class="btn btn-primary">Submit your business plan</a>
    </div>
  </section>

  <style>
    .page-hero { padding-top: 72px; padding-bottom: 40px; }
    .page-hero h1 {
      margin-top: 16px;
      font-size: clamp(36px, 5.5vw, 58px);
      font-weight: 900;
    }
    .page-sub {
      margin-top: 16px;
      font-size: 17px;
      color: var(--slate);
      max-width: 50ch;
    }

    .events-list { padding-top: 24px; }
    .event-row {
      display: grid;
      grid-template-columns: 100px 1fr;
      gap: 32px;
      padding: 40px 0;
      border-top: 1px solid var(--line);
    }
    .event-row:last-child { border-bottom: 1px solid var(--line); }
    .exp { font-size: 26px; }
    .event-tag {
      font-family: var(--font-mono);
      font-size: 11.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
    }
    .event-body h2 {
      margin-top: 10px;
      font-size: 26px;
      font-weight: 800;
    }
    .event-body p {
      margin-top: 14px;
      color: var(--slate);
      max-width: 68ch;
      font-size: 15.5px;
    }
    .event-meta {
      margin-top: 18px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .event-meta span {
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 5px 12px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      color: var(--slate);
    }

    .cta-strip { background: var(--maroon-soft); }
    .cta-strip-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .cta-strip h2 { font-size: clamp(22px, 3vw, 30px); color: var(--maroon-deep); }

    @media (max-width: 640px) {
      .event-row { grid-template-columns: 50px 1fr; gap: 18px; }
    }
  </style>
</Layout>
